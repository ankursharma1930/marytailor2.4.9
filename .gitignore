# ---------------------------------------------------------------- Magento core
# Composer-managed. Reproduced from composer.lock, which MUST stay tracked.
/vendor/*
!/vendor/.htaccess

# Generated at build time by setup:di:compile
/generated/*
!/generated/.htaccess

# Deployed by setup:static-content:deploy.
# NOTE: pub/static/.htaccess ships in the distribution and is NOT regenerated by
# the deploy command. Losing it makes the whole storefront load unstyled, so it
# is deliberately kept in the repo. See doc/00-local-environment-setup.md.
/pub/static/*
!/pub/static/.htaccess

# Runtime: cache, sessions, logs, reports, preprocessed views
/var/*
!/var/.htaccess

# ------------------------------------------------------------------ secrets
# env.php holds the database credentials and crypt key. Tracked previously;
# untracked as part of the 2.4.9 repo hygiene work. Ship env.php.sample instead.
/app/etc/env.php

# Composer credentials for repo.magento.com, Hyva, Plumrocket and Mirasvit.
/auth.json

# app/etc/config.php IS intentionally tracked -- it carries the module enable
# list (403 modules, 7 disabled) and is required for pipeline deployment.

# ------------------------------------------------------------------- uploads
/pub/media/*
!/pub/media/.htaccess
!/pub/media/customer/.htaccess
!/pub/media/downloadable/.htaccess
!/pub/media/import/.htaccess
!/pub/media/theme_customization/.htaccess
/pub/sitemap.xml
/pub/robots.txt

# --------------------------------------------------------------- build output
/node_modules/
/.grunt
/Gruntfile.js
/package.json
/package-lock.json
/grunt-config.json
/dev/tests/js/jasmine/spec/
/.php_cs.cache
/.php-cs-fixer.cache

# ----------------------------------------------------------------------- IDE
/.idea/
/.vscode/
/nbproject/
/.settings/
/.project
/.buildpath
/.metadata
atlassian*
*.swp
*~
.DS_Store

# ------------------------------------------- archives, dumps and scratch files
# Legacy scratch files in the project root. Not part of the application --
# ignored so they are not carried into the new repository. Nothing is deleted.
*.zip
*.tar.gz
*.sql
*.sql.gz
/backup/
/root
/info.php
/custom.php
/change.php
/homepage.php
/Live_homepage_backup.php
/category_page_css.css
/.htaccess11
/composer (copy).json
/all.sh
/redirect.sh
/updated modules/
/marytylor_module_details
/Require_things_to_upgrade_marytylor

# composer.lock is NOT ignored -- with vendor/ untracked it is the only record
# of exactly which versions this install runs.
