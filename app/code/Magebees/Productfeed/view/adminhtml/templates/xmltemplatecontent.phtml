<?php
$template = $this->getFeedModelTemplate();
if ( $this->getRequest()->getParam( 'template' ) ) {
	$template_id = $this->getRequest()->getParam( 'template' );
	if ( $template_id != "" ) {
		$template_information = $template->load( $template_id );
		if ( $template_information->getType() == "csv" ) {
			$csv_json_content = $template_information->getContent();
			$csv_content = json_decode( $csv_json_content, true );
		} else if ( $template_information->getType() == "xml" ) {
			$xml_json_content = $template_information->getContent();
			$xml_content = json_decode( $xml_json_content, true );
		}
	}
} else if ( $this->getRequest()->getParam( 'id' ) ) {

	$feed_id = $this->getRequest()->getParam( 'id' );


	if ( $feed_id != "" ) {
		$template_feed_information = $template->load( $feed_id );
		if ( $template_feed_information->getType() == "csv" ) {
			$csv_json_content = $template_feed_information->getContent();
			$csv_content = json_decode( $csv_json_content, true );
		} else if ( $template_feed_information->getType() == "xml" ) {
			$xml_json_content = $template_feed_information->getContent();
			$xml_content = json_decode( $xml_json_content, true );
		}
	}
}
