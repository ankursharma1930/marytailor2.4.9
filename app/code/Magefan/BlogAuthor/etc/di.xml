<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <virtualType name="Magefan\BlogAuthor\ImageUpload" type="Magento\Catalog\Model\ImageUploader">
        <arguments>
            <argument name="baseTmpPath" xsi:type="string">magefan_blogauthor/tmp</argument>
            <argument name="basePath" xsi:type="string">magefan_blogauthor</argument>
            <argument name="allowedExtensions" xsi:type="array">
                <item name="jpg" xsi:type="string">jpg</item>
                <item name="jpeg" xsi:type="string">jpeg</item>
                <item name="gif" xsi:type="string">gif</item>
                <item name="png" xsi:type="string">png</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="Magefan\BlogAuthor\Controller\Adminhtml\Author\Upload\FeaturedImg">
        <arguments>
            <argument name="imageUploader" xsi:type="object">Magefan\BlogAuthor\ImageUpload</argument>
        </arguments>
    </type>


    <preference for="Magefan\Blog\Api\AuthorInterface" type="Magefan\BlogAuthor\Model\Author" />
    <preference for="Magefan\Blog\Api\AuthorResourceModelInterface" type="Magefan\BlogAuthor\Model\ResourceModel\Author" />
    <preference for="Magefan\Blog\Api\AuthorCollectionInterface" type="Magefan\BlogAuthor\Model\ResourceModel\Author\Collection" />

    <type name="Magefan\Blog\Model\TemplatePool">
        <arguments>
            <argument name="templates" xsi:type="array">
                <item name="blog_post_latest_posts_by_author" xsi:type="array">
                    <item name="default" xsi:type="array">
                        <item name="label" xsi:type="string">Use System Settings</item>
                        <item name="value" xsi:type="string"></item>
                        <item name="template" xsi:type="string">Magefan_BlogAuthor::post/view/latest-posts-by-author.phtml</item>
                    </item>
                    <item name="list" xsi:type="array">
                        <item name="label" xsi:type="string">Modern</item>
                        <item name="value" xsi:type="string">modern</item>
                        <item name="template" xsi:type="string">Magefan_BlogAuthor::post/view/latest-posts-by-author-modern.phtml</item>
                    </item>
                </item>
            </argument>
        </arguments>
    </type>

    <virtualType name="Magefan\Blog\Model\Config\Source\LatestPostByAuthorTemplate" type="Magefan\Blog\Model\Config\Source\Template">
        <arguments>
            <argument name="templateType" xsi:type="string">blog_post_latest_posts_by_author</argument>
        </arguments>
    </virtualType>

    <type name="Magefan\Blog\Model\Post">
        <plugin name="Magefan_BlogAuthor_Plugin_Magefan_Blog_Model_Post" type="Magefan\BlogAuthor\Plugin\Magefan\Blog\Model\Post" sortOrder="10" disabled="false"/>
    </type>
    <type name="Magefan\Blog\Model\ResourceModel\Post">
        <plugin name="Magefan_BlogAuthor_Plugin_Magefan_Blog_Model_ResourceModel_Post" type="Magefan\BlogAuthor\Plugin\Magefan\Blog\Model\ResourceModel\Post" sortOrder="10" disabled="false"/>
    </type>
    <type name="Magefan\Blog\Model\ResourceModel\Post\Collection">
        <plugin name="Magefan_BlogAuthor_Plugin_Magefan_Blog_Model_ResourceModel_Post_Collection" type="Magefan\BlogAuthor\Plugin\Magefan\Blog\Model\ResourceModel\Post\Collection" sortOrder="10" disabled="false"/>
    </type>
</config>
