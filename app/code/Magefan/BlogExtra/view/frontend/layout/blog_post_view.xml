<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <block class="Magefan\BlogExtra\Block\Post\View\ReadingProgressBar" ifconfig="mfblog/post_view/reading_progress_bar/enabled" name="blog.post.reading.progressbar" as="reading_progressbar" after="-"  template="Magefan_BlogExtra::post/view/reading-progressbar.phtml"/>
        </referenceContainer>
        <referenceContainer name="blog.post.bottom">
            <block class="Magefan\BlogExtra\Block\Post\View\CategoryPosts" name="blog.post.categoryposts" as="categoryposts"  template="Magefan_BlogExtra::post/view/categoryposts.phtml" after="blogauthor.post.latest.posts.by.author" />
        </referenceContainer>
    </body>
</page>
