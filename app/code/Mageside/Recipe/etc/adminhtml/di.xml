<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <virtualType name="Magento\Recipe\Ui\DataProvider\Product\Form\Modifier\Pool" type="Magento\Ui\DataProvider\Modifier\Pool">
        <arguments>
            <argument name="modifiers" xsi:type="array">
                <item name="eav" xsi:type="array">
                    <item name="class" xsi:type="string">Magento\Catalog\Ui\DataProvider\Product\Form\Modifier\Eav</item>
                    <item name="sortOrder" xsi:type="number">10</item>
                </item>
            </argument>
        </arguments>
    </virtualType>
    <type name="Mageside\Recipe\Ui\DataProvider\Form\RecipeFilterDataProvider">
        <arguments>
            <argument name="pool" xsi:type="object">Magento\Recipe\Ui\DataProvider\Product\Form\Modifier\Pool</argument>
        </arguments>
    </type>

    <virtualType name="Mageside\Recipe\Ui\DataProvider\DataProvider" type="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider">
        <arguments>
            <argument name="reporting" xsi:type="object">Mageside\Recipe\Ui\DataProvider\Reporting</argument>
        </arguments>
    </virtualType>

    <virtualType name="Mageside\Recipe\Ui\DataProvider\Reporting" type="Magento\Framework\View\Element\UiComponent\DataProvider\Reporting">
        <arguments>
            <argument name="filterPool" xsi:type="object">Mageside\Recipe\Ui\DataProvider\FilterPool</argument>
        </arguments>
    </virtualType>

    <virtualType name="Mageside\Recipe\Ui\DataProvider\FilterPool" type="Magento\Framework\View\Element\UiComponent\DataProvider\FilterPool">
        <arguments>
            <argument name="appliers" xsi:type="array">
                <item name="regular" xsi:type="object">Magento\Framework\View\Element\UiComponent\DataProvider\RegularFilter</item>
                <item name="fulltext" xsi:type="object">Magento\Framework\View\Element\UiComponent\DataProvider\FulltextFilter</item>
                <item name="like" xsi:type="object">Mageside\Recipe\Ui\DataProvider\Reporting\LikeFilter</item>
            </argument>
        </arguments>
    </virtualType>

</config>
