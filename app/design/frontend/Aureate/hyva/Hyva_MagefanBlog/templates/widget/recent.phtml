<?php
$_postCollection = $block->getPostCollection();
$firstItem = false;
?>
<?php if ($_postCollection->count()) { ?>
    <div class="max-w-full md:max-w-6xl md:m-auto mx-auto">
        <div class="post-list-wrapper blog-widget-recent _card mb-10">
            <div
                class="container flex flex-col items-center pt-6 pb-3 mx-auto mb-6 md:flex-row justify-center border-b-2 border-gray-200">
                <h3 class="text-2xl font-bold text-gray-900 title-font"><span
                        class="text-neutral-400"><?= $block->escapeHtml($block->getTitle()) ?></span> from our blog</h3>
            </div>
            <ul class="grid grid-cols-2 md:grid-cols-3 gap-4">
                <?php foreach ($_postCollection as $_post) { ?>
                    <?php
                    $_postUrl = $block->escapeUrl($_post->getPostUrl());
                    $_postName = $block->escapeHtml($_post->getTitle());
                    ?>
                    <li class="max-w-full rounded-lg">
                        <div class="post-content">
                            <div class="post-description clearfix leading-5 text-xs">
                                <?php $featuredImage = $_post->getFeaturedListImage() ?: $_post->getFeaturedImage(); ?>
                                <?php if ($featuredImage) { ?>
                                    <?php
                                    $featuredImgAlt = $_post->getData('featured_list_img_alt') ?: $_post->getData('featured_img_alt');
                                    if (!$featuredImgAlt) {
                                        $featuredImgAlt = $_postName;
                                    }
                                    ?>
                                    <div class="post-ftimg-hld">
                                        <a href="<?= /*@noEscape*/
                                        $_postUrl ?>" title="<?= /*@noEscape*/
                                        $_postName ?>">
                                            <?php
                                            // Loads on the first interaction, or at once if on screen:
                                            // Magento_Theme::page/js/load-on-interaction.phtml. The placeholder
                                            // takes the image's own ratio when the file can be read, so the
                                            // card does not jump when the real image arrives.
                                            $featuredFile = BP . '/pub/media/' . ($_post->getData('featured_list_img') ?: $_post->getData('featured_img'));
                                            [$featuredW, $featuredH] = (is_file($featuredFile) ? @getimagesize($featuredFile) : false) ?: [1, 1];
                                            $featuredPlaceholder = 'data:image/svg+xml,' . rawurlencode(
                                                "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 $featuredW $featuredH'/>"
                                            );
                                            ?>
                                            <img class="w-full h-auto"
                                                 src="<?= $block->escapeHtmlAttr($featuredPlaceholder) ?>"
                                                 data-interaction-src="<?= $block->escapeHtml($featuredImage) ?>"
                                                 width="<?= (int) $featuredW ?>" height="<?= (int) $featuredH ?>"
                                                 loading="lazy"
                                                 alt="<?= $block->escapeHtml($featuredImgAlt) ?>"/>
                                        </a>
                                    </div>
                                <?php } ?>
                                <div class="border-2 border-gray-200 p-4">
                                    <div class="post-header">
                                        <div class="post-info clear pt-2 text-xs text-center my-3">
                                            <div class="w-full item post-posed-date inline-block">
                                            <?php if ($_post->isPublishDateEnabled()) { ?>

                                                    <span class="blog-post-meta-date inline-flex text-gray-700 mr-2 gap-x-1">
                                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                                             stroke="currentColor" class="w-4 h-4 flex-shrink-0" width="25" height="25">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                                  d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                                        </svg>
                                                        <?= $block->escapeHtml($_post->getPublishDate()) ?>
                                                    </span>

                                            <?php } ?>
                                            </div>
                                            <div class="item post-categories inline-block">
                                                <span class="blog-post-meta-cats block h-5 overflow-hidden text-ellipsis text-gray-700 mr-2 gap-x-1">
                                            <?php if ($_categoriesCount = $_post->getCategoriesCount()) { ?>


                                                       <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                                            stroke="currentColor" class="inline-block w-4 h-4" width="25" height="25">
                                                           <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                                 d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path>
                                                       </svg>
                                                        <?php $n = 0;
                                                        foreach ($_post->getParentCategories() as $ct) {
                                                            $n++;
                                                            ?>
                                                            <a title="<?= $block->escapeHtml($ct->getTitle()) ?>"
                                                               href="<?= $block->escapeUrl($ct->getCategoryUrl()) ?>">
                                                                <?= $block->escapeHtml($ct->getTitle()) ?>
                                                            </a>
                                                            <?php if ($n != $_categoriesCount) { ?>, <?php } ?>
                                                        <?php } ?>


                                            <?php } ?>
                                                    </span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="post-title-holder clearfix">
                                        <div class="post-title">
                                            <a class="post-item-link xt-md font-semibold text-lg text-center"
                                               href="<?= /*@noEscape*/ $_postUrl ?>">
                                                <?= /*@noEscape*/ $_postName ?>
                                            </a>
                                        </div>
                                    </div>
                                    <div class="post-text-hld clearfix mt-6 h-80">
                                        <?= /*@noEscape*/
                                        $block->getShorContent($_post, 900, '...') ?>
                                    </div>
                                    <a class="w-40 mx-auto btn my-4 justify-center hover:bg-gradient-to-bl text-sm mr-auto bg-gradient-to-br from-lime-600 to-lime-500 hover:underline"
                                       href="<?= /*@noEscape*/
                                       $_postUrl ?>"
                                       title="<?= /*@noEscape*/
                                       $_postName ?>"
                                    >
                                        <?= $block->escapeHtml(__('Read more &#187;')) ?>
                                    </a>
                                </div>
                            </div>
                        </div>

                    </li>
                    <?php $firstItem = true; ?>
                <?php } ?>
            </ul>
        </div>
    </div>
<?php } ?>
