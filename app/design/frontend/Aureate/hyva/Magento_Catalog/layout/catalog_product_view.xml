<page
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd"
>
    <body>
        <referenceBlock name="product.info.details">
            <arguments>
                <argument name="divider" xsi:type="boolean">false</argument> <!-- Show divider between items (true/false) -->
            </arguments>
        </referenceBlock>
        <referenceBlock name="description">
            <arguments>
                <argument name="title" xsi:type="string" translate="true">Description</argument>
            </arguments>
        </referenceBlock>
        <!--
            Related products and upsells. .pdp-product-slider hooks the carousel and
            card styling in web/tailwind/components/product-slider.css. Replaces the
            template default "product-slider my-8"; spacing comes from that file.
        -->
        <referenceBlock name="related">
            <arguments>
                <argument name="css_classes" xsi:type="string">product-slider pdp-product-slider</argument>
                <argument name="heading_css_classes" xsi:type="string">pdp-product-slider__title</argument>
            </arguments>
        </referenceBlock>
        <referenceBlock name="upsell">
            <arguments>
                <argument name="css_classes" xsi:type="string">product-slider pdp-product-slider</argument>
                <argument name="heading_css_classes" xsi:type="string">pdp-product-slider__title</argument>
            </arguments>
        </referenceBlock>
    </body>
</page>
