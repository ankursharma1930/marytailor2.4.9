<?php
/**
 * Override of hyva-themes/magento2-default-theme 1.5.2
 * Magento_Checkout::php-cart/noItems.phtml
 * Changes: centred empty-cart state with icon, heading and clearer copy.
 */

declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\LucideIcons;
use Magento\Checkout\Block\Cart;
use Magento\Framework\Escaper;

/** @var Cart $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

/** @var LucideIcons $lucideIcons */
$lucideIcons = $viewModels->require(LucideIcons::class);
?>
<div class="cart-empty">
    <?= $block->getChildHtml('checkout_cart_empty_widget') ?>
    <div class="flex flex-col items-center text-center py-12 md:py-16">
        <span class="flex items-center justify-center w-20 h-20 rounded-full bg-gray-100 text-gray-500">
            <?= $lucideIcons->shoppingCartHtml('', 36, 36, ['aria-hidden' => 'true']) ?>
        </span>
        <h2 class="mt-6 text-2xl font-bold"><?= $escaper->escapeHtml(__('Your cart is empty')) ?></h2>
        <p class="mt-2 max-w-md text-gray-600">
            <?= $escaper->escapeHtml(__("Looks like you haven't added anything to your cart yet.")) ?>
        </p>
        <a href="<?= $escaper->escapeUrl($block->getContinueShoppingUrl()) ?>" class="btn btn-primary mt-8">
            <?= $escaper->escapeHtml(__('Start Shopping')) ?>
        </a>
    </div>
    <?= $block->getChildHtml('shopping.cart.table.after') ?>
</div>
