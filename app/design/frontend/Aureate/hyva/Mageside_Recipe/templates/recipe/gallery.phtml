use Magento\Framework\Escaper;
use Mageside\Recipe\Block\Frontend\Recipe\GalleryImages;

/**
 * Main recipe image on the recipe page
 *
 * @var GalleryImages $block
 * @var Escaper $escaper
 */

$imageUrl = $block->returnImageUrl();
if (!$imageUrl) {
    return;
}

$parentBlock = $block->getParentBlock();
$title = $parentBlock ? (string) $parentBlock->getRecipe()->getTitle() : '';
$placeholderUrl = $block->getViewFileUrl('Mageside_Recipe::images/recipe-image-coming-soon.png');
?>
<img src="<?= $escaper->escapeUrl($imageUrl) ?>"
     onerror="this.onerror=null;this.src='<?= $escaper->escapeJs($placeholderUrl) ?>'"
     alt="<?= $escaper->escapeHtmlAttr($title) ?>"
     class="w-full rounded-2xl bg-gray-100 shadow-sm"
     fetchpriority="high">
