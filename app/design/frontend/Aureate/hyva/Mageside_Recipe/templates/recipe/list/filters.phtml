use Magento\Framework\Escaper;
use Mageside\Recipe\Block\Frontend\Recipe\Filters\RecipeFilterType;

/**
 * Filter selects, rendered inside the search form in recipe/recipes.phtml
 *
 * @var RecipeFilterType $block
 * @var Escaper $escaper
 */

$filterTypes = $block->getFilterType()->getItems();
if (!$filterTypes) {
    return;
}
?>
<div class="mt-4 grid grid-cols-2 gap-3 lg:grid-cols-4">
    <?php foreach ($filterTypes as $type): ?>
        <?php
        $code = (string) $type->getCode();
        $selected = $block->getRequest()->getParam($code);
        $selected = is_string($selected) ? $selected : '';
        $options = $block->getFilterOption($type->getId())->getData('options') ?: [];
        ?>
        <div>
            <label for="recipe-filter-<?= $escaper->escapeHtmlAttr($code) ?>"
                   class="mb-1 block text-xs font-semibold uppercase tracking-wide text-gray-500">
                <?= $escaper->escapeHtml($type->getType()) ?>
            </label>
            <select id="recipe-filter-<?= $escaper->escapeHtmlAttr($code) ?>"
                    name="<?= $escaper->escapeHtmlAttr($code) ?>"
                    class="form-select w-full rounded-lg text-sm">
                <option value=""><?= $escaper->escapeHtml(__('All')) ?></option>
                <?php foreach ($options as $option): ?>
                    <option value="<?= $escaper->escapeHtmlAttr($option['slug']) ?>"
                        <?= $selected === (string) $option['slug'] ? 'selected' : '' ?>>
                        <?= $escaper->escapeHtml($option['label']) ?>
                    </option>
                <?php endforeach; ?>
            </select>
        </div>
    <?php endforeach; ?>
</div>
