use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HeroiconsOutline;
use Magento\Framework\Escaper;
use Mageside\Recipe\Block\Frontend\Recipe\Recipe;
use Mageside\Recipe\Block\Frontend\Recipe\Review;
use Mageside\Recipe\Helper\Config;

/** @var Recipe $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

/** @var Config $config */
$config = $this->helper(Config::class);
/** @var HeroiconsOutline $heroicons */
$heroicons = $viewModels->require(HeroiconsOutline::class);

$recipe = $block->getRecipe();

$ingredients = array_filter(
    (array) $recipe->getIngredients(),
    static fn ($item) => trim(($item['measure'] ?? '') . ($item['ingredient'] ?? '')) !== ''
);
$steps = array_filter(
    (array) $recipe->getMethod(),
    static fn ($item) => trim($item['step'] ?? '') !== ''
);

$facts = array_filter([
    ['icon' => 'clock', 'label' => __('Prep time'), 'value' => $block->getFormattedDuration($recipe->getPrepTime())],
    ['icon' => 'fire', 'label' => __('Cook time'), 'value' => $block->getFormattedDuration($recipe->getCookTime())],
    ['icon' => 'users', 'label' => __('Serves'), 'value' => $block->getServings($recipe->getServingsNumber())],
], static fn ($fact) => (string) $fact['value'] !== '');

/** @var Review|false $reviewBlock */
$reviewBlock = $config->getReviewEnabled() ? $block->getChildBlock('recipe_review') : false;
$reviewCount = $reviewBlock ? (int) $reviewBlock->getReviewsSize() : 0;

$videoId = '';
if ($recipe->getMediaType() === 'video'
    && preg_match('~(?:youtu\.be/|[?&]v=|/embed/)([\w-]{11})~', (string) $recipe->getMediaTypeVideoUrl(), $matches)
) {
    $videoId = $matches[1];
}
?>
<article class="recipe-view pb-16">
    <div class="grid items-start gap-8 pt-6 lg:grid-cols-2 lg:gap-12 lg:pt-10">
        <div class="space-y-4">
            <?= $block->getChildHtml('recipe_image') ?>
            <?php if ($videoId): ?>
                <div class="aspect-video overflow-hidden rounded-2xl bg-gray-900">
                    <iframe src="https://www.youtube-nocookie.com/embed/<?= $escaper->escapeHtmlAttr($videoId) ?>"
                            title="<?= $escaper->escapeHtmlAttr(__('%1 video', $recipe->getTitle())) ?>"
                            class="h-full w-full"
                            loading="lazy"
                            allow="accelerometer; encrypted-media; gyroscope; picture-in-picture"
                            allowfullscreen></iframe>
                </div>
            <?php endif; ?>
        </div>

        <div>
            <h1 class="text-3xl font-bold leading-tight text-gray-900 md:text-4xl">
                <?= $escaper->escapeHtml($recipe->getTitle()) ?>
            </h1>

            <?php if ($reviewBlock): ?>
                <a href="#reviews" class="mt-3 inline-flex items-center gap-1.5 text-sm text-gray-600 hover:text-lime-700">
                    <?= $heroicons->chatAltHtml('', 18, 18, ['aria-hidden' => 'true']) ?>
                    <?php if ($reviewCount): ?>
                        <?= $escaper->escapeHtml($reviewCount === 1 ? __('1 review') : __('%1 reviews', $reviewCount)) ?>
                    <?php else: ?>
                        <?= $escaper->escapeHtml(__('Be the first to review this recipe')) ?>
                    <?php endif; ?>
                </a>
            <?php endif; ?>

            <?php if (!empty($recipe->getShortDescription())): ?>
                <div class="prose mt-4 max-w-none text-gray-700">
                    <?= /* @noEscape */ $recipe->getShortDescriptionHtml() ?>
                </div>
            <?php endif; ?>

            <?php if ($facts): ?>
                <dl class="mt-6 flex divide-x divide-gray-200 rounded-xl border border-gray-200 bg-gray-50">
                    <?php foreach ($facts as $fact): ?>
                        <div class="flex flex-1 flex-col items-center gap-1 px-2 py-4 text-center">
                            <dt class="flex flex-col items-center gap-1 text-xs font-medium uppercase tracking-wide text-gray-500">
                                <?= $heroicons->renderHtml($fact['icon'], 'text-lime-700', 24, 24, ['aria-hidden' => 'true']) ?>
                                <?= $escaper->escapeHtml($fact['label']) ?>
                            </dt>
                            <dd class="text-base font-semibold text-gray-900"><?= $escaper->escapeHtml($fact['value']) ?></dd>
                        </div>
                    <?php endforeach; ?>
                </dl>
            <?php endif; ?>

            <div class="mt-6 flex flex-wrap items-center gap-3">
                <?php if ($ingredients || $steps): ?>
                    <a href="<?= $ingredients ? '#recipe-ingredients' : '#recipe-method' ?>" class="btn btn-primary">
                        <?= $escaper->escapeHtml(__('Jump to recipe')) ?>
                    </a>
                <?php endif; ?>
                <?= $block->getChildHtml('recipe.view.print.button') ?>
            </div>

            <?= $block->getChildHtml('social_sharing') ?>
        </div>
    </div>

    <?php if ($ingredients || $steps): ?>
        <div class="mt-12 grid items-start gap-8 lg:mt-16 lg:grid-cols-3 lg:gap-12">
            <?php if ($ingredients): ?>
                <section id="recipe-ingredients"
                         class="scroll-mt-24 rounded-2xl border border-gray-200 bg-white p-6 shadow-sm lg:sticky lg:top-6"
                         aria-labelledby="recipe-ingredients-title">
                    <h2 id="recipe-ingredients-title" class="flex items-baseline justify-between gap-2 text-xl font-bold text-gray-900">
                        <?= $escaper->escapeHtml(__('Ingredients')) ?>
                        <span class="text-sm font-normal text-gray-500">
                            <?= $escaper->escapeHtml(count($ingredients) === 1 ? __('1 item') : __('%1 items', count($ingredients))) ?>
                        </span>
                    </h2>
                    <ul role="list" class="mt-4 divide-y divide-gray-100">
                        <?php foreach ($ingredients as $item): ?>
                            <li class="flex gap-3 py-2.5 text-sm">
                                <span class="w-24 shrink-0 font-semibold text-gray-900">
                                    <?= $escaper->escapeHtml(trim($item['measure'] ?? '')) ?>
                                </span>
                                <span class="text-gray-700">
                                    <?php if (!empty($item['url'])): ?>
                                        <a href="<?= $escaper->escapeUrl($item['url']) ?>"
                                           target="_blank"
                                           rel="noopener"
                                           class="text-lime-700 underline decoration-lime-300 underline-offset-2 hover:text-lime-800">
                                            <?= $escaper->escapeHtml($item['ingredient'] ?? '') ?>
                                        </a>
                                    <?php else: ?>
                                        <?= $escaper->escapeHtml($item['ingredient'] ?? '') ?>
                                    <?php endif; ?>
                                </span>
                            </li>
                        <?php endforeach; ?>
                    </ul>
                </section>
            <?php endif; ?>

            <?php if ($steps): ?>
                <section id="recipe-method"
                         class="scroll-mt-24 <?= $ingredients ? 'lg:col-span-2' : 'lg:col-span-3' ?>"
                         aria-labelledby="recipe-method-title">
                    <h2 id="recipe-method-title" class="text-xl font-bold text-gray-900">
                        <?= $escaper->escapeHtml(__('Method')) ?>
                    </h2>
                    <ol role="list" class="mt-4 space-y-3">
                        <?php $stepNumber = 0; ?>
                        <?php foreach ($steps as $item): ?>
                            <li class="flex gap-4 rounded-xl bg-gray-50 p-4">
                                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-lime-700 text-sm font-bold text-white"
                                      aria-hidden="true"><?= ++$stepNumber ?></span>
                                <p class="whitespace-pre-line pt-1 leading-relaxed text-gray-800"><?= $escaper->escapeHtml(trim($item['step'])) ?></p>
                            </li>
                        <?php endforeach; ?>
                    </ol>
                </section>
            <?php endif; ?>
        </div>
    <?php endif; ?>

    <?php if (!empty($recipe->getAssignedProductIds())): ?>
        <section class="mt-16" aria-labelledby="recipe-products-title">
            <h2 id="recipe-products-title" class="border-b border-gray-200 pb-3 text-2xl font-bold text-gray-900">
                <?= $escaper->escapeHtml(__('Products you will need')) ?>
            </h2>
            <?= $block->getChildHtml('ingredients_list') ?>
        </section>
    <?php endif; ?>

    <?php if ($reviewBlock): ?>
        <?= $block->getChildHtml('recipe_review') ?>
    <?php endif; ?>
</article>
