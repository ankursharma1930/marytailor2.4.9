use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HeroiconsOutline;
use Magento\Framework\Escaper;
use Mageside\Recipe\Block\Frontend\Recipe\Recipe;
use Mageside\Recipe\Helper\Config;

/** @var Recipe $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

/** @var Config $config */
$config = $this->helper(Config::class);
if (!$config->getSocialShareEnable()) {
    return;
}

/** @var HeroiconsOutline $heroicons */
$heroicons = $viewModels->require(HeroiconsOutline::class);

$recipe = $block->getRecipe();
$url = $config->getRecipeUrl($recipe);
$title = (string) $recipe->getTitle();
$imageUrl = $recipe->getMediaTypeImage() ? $block->getImageUrl() . '/' . $recipe->getMediaTypeImage() : '';

// The "Google Share" setting is ignored: Google+ was shut down in 2019.
$networks = array_filter([
    $config->getFacebookShare() ? [
        'label' => 'Facebook',
        'url'   => 'https://www.facebook.com/sharer/sharer.php?' . http_build_query(['u' => $url]),
        'path'  => 'M9 8H6v4h3v12h5V12h3.642L18 8h-4V6.333C14 5.378 14.192 5 15.115 5H18V0h-3.808C10.596 0 9 1.583 9 4.615V8z',
    ] : null,
    $config->getTwitterShare() ? [
        'label' => 'X',
        'url'   => 'https://twitter.com/intent/tweet?' . http_build_query(['url' => $url, 'text' => $title]),
        'path'  => 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z',
    ] : null,
    $config->getPinterestShare() ? [
        'label' => 'Pinterest',
        'url'   => 'https://pinterest.com/pin/create/button/?'
            . http_build_query(['url' => $url, 'media' => $imageUrl, 'description' => $title]),
        'path'  => 'M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.55.535 6.607 0 11.985-5.365 11.985-11.987C23.97 5.39 18.592.026 11.985.026L12.017 0z',
    ] : null,
]);
$circleClasses = 'inline-flex h-10 w-10 items-center justify-center rounded-full border border-gray-300 text-gray-700 '
    . 'transition hover:border-gray-900 hover:bg-gray-900 hover:text-white';
?>
<div class="mt-6 flex flex-wrap items-center gap-2 border-t border-gray-200 pt-6" x-data="initRecipeShare()">
    <span class="mr-1 text-sm font-medium text-gray-600"><?= $escaper->escapeHtml(__('Share')) ?></span>
    <?php foreach ($networks as $network): ?>
        <?php $label = __('Share on %1', $network['label']); ?>
        <a href="<?= $escaper->escapeUrl($network['url']) ?>"
           target="_blank"
           rel="noopener nofollow"
           title="<?= $escaper->escapeHtmlAttr($label) ?>"
           aria-label="<?= $escaper->escapeHtmlAttr($label) ?>"
           class="<?= /* @noEscape */ $circleClasses ?>">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path d="<?= /* @noEscape */ $network['path'] ?>"/>
            </svg>
        </a>
    <?php endforeach; ?>
    <button type="button"
            class="inline-flex h-10 items-center gap-2 rounded-full border border-gray-300 px-4 text-sm text-gray-700 transition hover:border-gray-900 hover:bg-gray-900 hover:text-white"
            @click="copy('<?= $escaper->escapeJs($url) ?>')">
        <?= $heroicons->linkHtml('', 16, 16, ['aria-hidden' => 'true']) ?>
        <span x-text="copied ? '<?= $escaper->escapeJs(__('Link copied')) ?>' : '<?= $escaper->escapeJs(__('Copy link')) ?>'">
            <?= $escaper->escapeHtml(__('Copy link')) ?>
        </span>
    </button>
</div>
<script>
    function initRecipeShare() {
        return {
            copied: false,
            copy(url) {
                const done = () => {
                    this.copied = true;
                    setTimeout(() => { this.copied = false; }, 2000);
                };
                if (navigator.clipboard && window.isSecureContext) {
                    navigator.clipboard.writeText(url).then(done);
                    return;
                }
                // The Clipboard API is unavailable outside HTTPS
                const field = document.createElement('textarea');
                field.value = url;
                document.body.appendChild(field);
                field.select();
                document.execCommand('copy');
                field.remove();
                done();
            }
        };
    }
</script>
